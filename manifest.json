{
  "manifest_version": 3,
  "name": "我的导航 · 一键收藏",
  "version": "1.0.0",
  "description": "将当前网页收藏到 home.zhaoyouning.com，支持选择分组和重复收藏提醒。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://home-api.zhaoyouning.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "收藏到我的导航",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://home-api.zhaoyouning.com"
  }
}
